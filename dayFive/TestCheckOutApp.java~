public class TestCheckOutApp{

    @Test
    public void testThatMethodGetsUserInformation(){
        // Arrange
        String expectedResult = "Olukayode";
        
        // Act
        String actualResult = CheckOutApp.getCustomerInfo();
        
        // Assert
        assertEquals(expectedResult, actualResult);
    }
    
